{
  "name": "moovie",
  "version": "4.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build --webpack",
    "start": "next start -p 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "npm run typecheck",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate:postgres": "prisma generate --schema=prisma/schema.postgres.prisma",
    "db:migrate:postgres": "prisma migrate deploy --schema=prisma/schema.postgres.prisma",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "test:unit": "tsx --test tests/unit.test.ts",
    "test:e2e": "tsx --test tests/e2e.test.ts",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.5.18",
    "lucide-react": "^1.24.0",
    "next": "^16.4.2",
    "next-auth": "^4.24.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.5",
    "@types/react-dom": "^19.0.3",
    "playwright": "^1.48.2",
    "prisma": "^7.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
